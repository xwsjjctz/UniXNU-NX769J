Trace NX769J client submissions: print the failure point and IOReturn so a Turnip DEVICE_LOST can be read on the console.

--- a/NativeAdrenoUserClient.cpp	2026-11-06 22:43:04
+++ b/NativeAdrenoUserClient.cpp	2026-11-06 22:43:27
@@ -408,6 +408,13 @@
         if(priority_told_<0xffffffffu)++priority_told_;
     }
     return kIOReturnSuccess;
+}
+/* NX769J: trace the first client submissions and every failure point, so a DEVICE_LOST in Turnip can be read on the console. */
+static volatile SInt32 nx769j_submit_log;
+static void nx769j_submit_trace(const char *where,IOReturn kr,uint32_t a,uint32_t b)
+{
+    if(OSIncrementAtomic(&nx769j_submit_log)<32)
+        printf("NX769J SUBMIT: %s kr=0x%x a=%u b=%u pid=%d\n",where,kr,a,b,proc_selfpid());
 }
