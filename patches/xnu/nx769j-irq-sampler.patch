diff -ru a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c	2026-11-03 18:43:19
+++ b/osfmk/arm64/sleh.c	2026-11-03 18:43:19
@@ -1846,6 +1846,43 @@
 	__builtin_unreachable();
 }
 
+/*
+ * NX769J: every interrupt that lands on pid 1 records the interrupted pc,
+ * lr and two frame-pointer return addresses, unslid when in the kernel.
+ * The heartbeat in bsd_init prints the newest entries.
+ */
+volatile uint64_t nx769j_irq_ring[16][5];
+volatile uint32_t nx769j_irq_next;
+static void
+nx769j_irq_sample(arm_saved_state_t *state)
+{
+	thread_t thread = current_thread();
+	task_t task = get_threadtask(thread);
+	void *proc = (task && task != kernel_task) ? get_bsdtask_info(task) : NULL;
+
+	if (proc == NULL || proc_pid((struct proc *)proc) != 1) {
+		return;
+	}
+	uint64_t cpsr = get_saved_state_cpsr(state);
+	int kernel = (cpsr & 0xc) != 0;
+	uint64_t frames[2] = {0, 0};
+	if (kernel && thread->kernel_stack) {
+		vm_offset_t low = thread->kernel_stack, high = low + kernel_stack_size;
+		uint64_t fp = get_saved_state_fp(state);
+		for (int i = 0; i < 2 && fp >= low && fp + 16 <= high && (fp & 0xf) == 0; i++) {
+			frames[i] = VM_KERNEL_UNSLIDE(((uint64_t *)fp)[1]);
+			fp = ((uint64_t *)fp)[0];
+		}
+	}
+	uint32_t slot = nx769j_irq_next++ & 15;
+	uint64_t pc = get_saved_state_pc(state), lr = get_saved_state_lr(state);
+	nx769j_irq_ring[slot][0] = (uint64_t)kernel | ((uint64_t)thread->thread_id << 8);
+	nx769j_irq_ring[slot][1] = kernel ? VM_KERNEL_UNSLIDE(pc) : pc;
+	nx769j_irq_ring[slot][2] = kernel ? VM_KERNEL_UNSLIDE(lr) : lr;
+	nx769j_irq_ring[slot][3] = frames[0];
+	nx769j_irq_ring[slot][4] = frames[1];
+}
+
 void
 sleh_irq(arm_saved_state_t *state)
 {
@@ -1857,6 +1895,7 @@
 
 	sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_OTHER);
 	boot_progress_irq(get_saved_state_pc(state), get_saved_state_cpsr(state), get_saved_state_sp(state));
+	nx769j_irq_sample(state);
 
 #if USE_APPLEARMSMP
 	PE_handle_ext_interrupt();
@@ -1891,6 +1930,7 @@
 	uint64_t pmcr0 = 0, upmsr = 0;
 #endif /* MONOTONIC_FIQ */
 
+	nx769j_irq_sample(state);
 #if defined(HAS_IPI)
 	boolean_t    is_ipi = FALSE;
 	uint64_t     ipi_sr = 0;
diff -ru a/osfmk/kern/bsd_kern.c b/osfmk/kern/bsd_kern.c
--- a/osfmk/kern/bsd_kern.c	2026-11-03 18:43:19
+++ b/osfmk/kern/bsd_kern.c	2026-11-03 18:43:19
@@ -1537,7 +1537,7 @@
 			break;
 		}
 		const arm_saved_state_t *state = get_user_regs(thread);
-		uint64_t *row = rows + 8 * count++;
+		uint64_t *row = rows + 12 * count++;
 		row[0] = thread->thread_id;
 		row[1] = ((uint64_t)thread->block_hint << 32) | (uint32_t)thread->state;
 		row[2] = (uint64_t)VM_KERNEL_UNSLIDE_OR_PERM((vm_offset_t)thread->wait_event);
@@ -1546,6 +1546,9 @@
 		row[5] = state ? get_saved_state_lr(state) : 0;
 		row[6] = state ? get_saved_state_sp(state) : 0;
 		row[7] = state ? get_saved_state_reg(state, 16) : 0;
+		for (unsigned reg = 0; reg < 4; reg++) {
+			row[8 + reg] = state ? get_saved_state_reg(state, reg) : 0;
+		}
 	}
 	task_unlock(task);
 	return count;
