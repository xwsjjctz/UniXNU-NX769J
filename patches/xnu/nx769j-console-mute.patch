Stop the text console from drawing over the GUI when the board asks.

The board framebuffer sets houji_console_muted on its first present when
sweetfb_noconsole=1 is given. Output still reaches serial; once a panic
enters the debugger the console draws again.

--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -1228,9 +1228,18 @@
 	gc_ops.update_color(color, fore);
 }
 
+/*
+ * Set by the board framebuffer (boot-arg sweetfb_noconsole=1) on the first
+ * GUI frame, so the text console stops drawing over it. A panic draws again.
+ */
+int houji_console_muted = 0;
+
 void
 vcputc_options(char c, __unused bool poll)
 {
+	if (houji_console_muted && kernel_debugger_entry_count == 0) {
+		return;
+	}
 	if (boot_progress_active()) { boot_progress_putc(c); return; }
 	if (gc_initialized && gc_enabled) {
 		VCPUTC_LOCK_LOCK();
