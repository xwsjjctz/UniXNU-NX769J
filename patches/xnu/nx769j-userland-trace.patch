diff -ru a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c	2026-11-03 12:39:45
+++ b/bsd/kern/bsd_init.c	2026-11-03 12:39:45
@@ -1275,8 +1275,28 @@
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+	{
+		extern void nx769j_heartbeat(void *, wait_result_t);
+		thread_t nx769j_thread;
+		if (kernel_thread_start(nx769j_heartbeat, NULL, &nx769j_thread) == KERN_SUCCESS) {
+			thread_deallocate(nx769j_thread);
+		}
+	}
 	load_init_program(p);
 	lock_trace = 1;
+}
+
+/* NX769J: print uptime and process count every 15 seconds after launchd starts. */
+void nx769j_heartbeat(void *, wait_result_t);
+void
+nx769j_heartbeat(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		delay(15 * 1000 * 1000);
+		uint64_t seconds = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &seconds);
+		printf("NX769J alive %llus nprocs %d\n", seconds / NSEC_PER_SEC, nprocs);
+	}
 }
 
 kern_return_t
