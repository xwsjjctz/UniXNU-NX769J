+		    p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
+		    p->p_exit_reason ? p->p_exit_reason->osr_code : 0ULL,
+		    (unsigned)proc_getcsflags(p), nx769j_desc ? nx769j_desc : "");
+	}
 
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
diff -ru a/osfmk/kern/boot_progress.h b/osfmk/kern/boot_progress.h
--- a/osfmk/kern/boot_progress.h	2026-11-03 12:39:45
+++ b/osfmk/kern/boot_progress.h	2026-11-03 12:39:45
@@ -28,7 +28,17 @@
 #define boot_progress_user_breakpoint(...) ((void)0)
 #define boot_progress_user_abort(...) ((void)0)
 #define boot_progress_critical_exit(...) ((void)0)
+/*
+ * NX769J: the panel console is the only output after launchd starts, so the
+ * per-process exec stages print there when the boot progress layer is absent.
+ */
+#if defined(KERNEL_PRIVATE) && defined(BSD_KERNEL_PRIVATE)
+extern int printf(const char *, ...);
+#define boot_progress_process_stage(pid, name, stage) \
+	printf("NX769J proc %d %s: %s\n", (int)(pid), (name), (stage))
+#else
 #define boot_progress_process_stage(...) ((void)0)
+#endif
 #define boot_progress_exit(...) ((void)0)
 #endif
 #endif
