+/*
+ * NX769J: boot-arg nx769j-execswap=<path>=<replacement>[,<path>=<replacement>] runs <replacement> wherever <path> is executed
+ * (an exact match of the whole path), so a test program can take the place of a RunAtLoad job launchd already knows from its
+ * cache. The replacement still has to pass AMFI on its own signature through the trust cache.
+ *
+ * With the boot-arg set, every exec below /private/var/ngpu/bin/ (the replacements and what they spawn) is marked
+ * IMGPF_NX769J_EXECSWAP. The platform Sandbox refuses exec from the Data volume, so mac_vnode_check_exec ignores the
+ * Sandbox verdict for a marked image, and process_signature ignores its launch-constraint refusal (the owner trust module
+ * gives the binary no constraint category); AMFI's signature checks and every other policy still decide. A marked exec that fails prints its stage,
+ * its uid and every MAC policy that refused it.
+ */
+static int nx769j_exec_test_dir;
+
+static const char *
+nx769j_exec_swap(const char *path)
+{
+	static char arg[256];
+	static const char *from[2], *to[2];
+	static int parsed;
+	static int enabled;
+	static unsigned logged;
+	if (!parsed) {
+		parsed = 1;
+		if (PE_parse_boot_argn("nx769j-execswap", arg, sizeof(arg))) {
+			enabled = 1;
+			char *cursor = arg;
+			for (int n = 0; n < 2 && cursor && *cursor; n++) {
+				char *next = strchr(cursor, ',');
+				if (next) {
+					*next++ = 0;
+				}
+				char *eq = strchr(cursor, '=');
+				if (eq && eq != cursor && eq[1] == '/') {
+					*eq = 0;
+					from[n] = cursor;
+					to[n] = eq + 1;
+				}
+				cursor = next;
+			}
+		}
+	}
+	nx769j_exec_test_dir = enabled;
+	for (int n = 0; n < 2; n++) {
+		if (from[n] && path && strcmp(path, from[n]) == 0) {
+			if (logged < 16) {
+				logged++;
+				printf("NX769J EXECSWAP: %s -> %s\n", from[n], to[n]);
+			}
+			return to[n];
+		}
+	}
+	return NULL;
+}
