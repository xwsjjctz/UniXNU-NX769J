# NX769J kernel configuration.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build script: y and n are 1
# and 0, a quoted string or a number is passed through, {tree} is the build tree.
#
# Configuration fragments apply first in this order:
#   arch:configs/common.config  soc:configs/sm8550.config  os:configs/ipados.config
# and this file is applied last, so a value set here replaces the inherited one.

# Supplied by arch:configs/common.config and repeated for readability:
#   CONFIG_XNU_BUILD_ARCHIVES=y
#   CONFIG_XNU_SOURCE_CORECRYPTO14=y
#   CONFIG_XNU_SOURCE_PTHREAD=y
#   CONFIG_XNU_ARM_DT_PLATFORM=y
#   CONFIG_XNU_ARMCPU=y
#   CONFIG_XNU_NATIVE_AES=y
#   CONFIG_XNU_NATIVE_ARCH_TIMER=y
#   CONFIG_XNU_NATIVE_PAN=y

# The kernel link consumes the prelinked native drivers and the original kexts.
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"

# DT handoff and diagnostics.
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y

# Storage. ShengUfs drives the SM8650 UFS controller and VirtioMmioBlock
# publishes its request transport; VerifiedRoot authenticates block reads.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y

# Two archives the link needs but that no config flag pulls in on its own.
# ShengUfs subclasses IOBlockStorageDevice, which lives in the prelinked
# IOStorageFamily kext: compiling the class in as well registers it twice and
# panics, so libStorageBindings.a resolves the inherited slots to the original
# prelinked code with absolute symbols. libVerifiedRoot.a carries the real
# VerifiedRoot crypto together with this board's policy table, which is empty
# until a signed bundle exists.
#
# [kernel] archives builds both before the link; this puts them on the link line
# so ld64 pulls the members in against the driver's unresolved references.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/io-storage-family/libStorageBindings.a -Wl,-force_load,{tree}/build/verified-root/libVerifiedRoot.a -Wl,-force_load,{tree}/build/apple-key-store-state/libAppleKeyStoreState.a -Wl,-force_load,{tree}/build/nx769j-keystore/libNX769JKeyStore.a -Wl,-force_load,{tree}/build/ram-block/libRamBlock.a"

# Display. GopFramebuffer presents through the UEFI GOP framebuffer that the
# uefi-nx769j firmware publishes, but its kernel-side provider is a late
# archive that no builder in this tree produces yet, and the symbols it would
# define (native_legacy_display_probe, native_legacy_display_provider_probe)
# are referenced from bsd_init and IOUserClient behind these very flags. Both
# stay off until the archive exists, so the kernel links headless. Turn them on
# together with the archive.
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_MOBILE_DISPLAY is not set

# soc:configs/sm8550.config sets CONFIG_XNU_NATIVE_ADRENO=y. The SM8550 GPU
# stack targets Adreno 740; NX769J has Adreno 750 (qcom,adreno-43051401 with
# qcom,adreno-gmu-750.1) and has no qualified driver, so the native GPU path is
# off until one is selected.
CONFIG_XNU_NATIVE_ADRENO=n

# Not a QEMU board. The ArmVirtPlatform expert would claim the platform.
# CONFIG_XNU_ARMVIRT_PLATFORM is not set

# No board PMGR driver is selected yet. The SM8650 has no Apple PMGR block, and
# the caihong SM8650 port reports "AMFI: No PMGR?" panics from the AMFI early
# security init path on this SoC family.
# CONFIG_XNU_SHENG_PMGR is not set

# Owner chain. NativeUfs verifies both root windows against owner-signed
# policies with the source corecrypto build, which is what SOURCE_STORAGE
# declares. ROOT_TRUST accepts the OS root only when its media is one of those
# windows. CACHE_MOUNT unions the SystemOS window over / so dyld finds the
# shared cache; without it launchd stops at shared_region check_np.
# The UUIDs are the ones signed into scripts/policies/ios-16.5-20F66.
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/virtio-mmio-block-verified-bundle/libVirtioMmioBlock.a"
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="556915A0-5005-4DE5-B3E4-6B489DBB4C1A"
CONFIG_XNU_OWNER_ROOT_VOLUME_UUID="97A3EB1A-5218-4936-BC85-9574EC2C8CC9"

# Writable /private/var: a packed APFS seed (scripts/build-data-seed.py) travels
# in the payload, RamBlock serves it from RAM and load_init_program mounts it.
# It is reset on every boot. The UUID is the seed's own volume, printed by the
# seed builder; rebuild the kernel when the seed is rebuilt. With SOURCE_STORAGE
# the build script neither links RamBlock nor adds its personality, so the
# archive is in EXTRA_LD_ARCHIVES and patches/xnu/nx769j-ram-block-personality.patch
# adds the personality.
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="09A4C386-8B5A-46F3-8817-D0B96D69AC3C"
